<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="300"
    d:DesignHeight="120"
    x:Class="VaultCrypt.Avalonia.Views.PasswordInput"
    xmlns:vm="clr-namespace:VaultCrypt.ViewModels;assembly=VaultCrypt"
    x:DataType="vm:PasswordInputViewModel"
    MinHeight="120" MinWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" Grid.ColumnSpan="2" Content=" Go back " HorizontalAlignment="Left" Command="{Binding GoBackCommand}"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" TextAlignment="Right"/>
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="20" PasswordChar="#" Text="{Binding PasswordString, Mode=OneWayToSource}"></TextBox>
        <Button Grid.Row="2" Grid.Column="1" Content=" Open " Command="{Binding OpenVaultCommand}"/>
    </Grid>
</UserControl>
