<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="450"
    x:Class="VaultCrypt.Avalonia.Views.Progress"
    xmlns:vm="clr-namespace:VaultCrypt.ViewModels;assembly=VaultCrypt"
    x:DataType="vm:ProgressViewModel">
    
    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Working..."/>
            <ProgressBar Minimum="0" Maximum="{Binding Context.Total}" Value="{Binding Context.Completed, Mode=OneWay}"/>
            <TextBlock HorizontalAlignment="Right">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}/{1}">
                        <Binding Path="Context.Completed"/>
                        <Binding Path="Context.Total"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Text="{Binding TempMessage, FallbackValue=Error: This is example of an error}" TextWrapping="NoWrap" Foreground="Red" HorizontalAlignment="Center"/>
            
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="250">
                <ItemsControl ItemsSource="{Binding PermMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="OK" Command="{Binding FinishCommand}"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
    
</UserControl>
